GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.0-flash
MCP_SERVERS_JSON={"filesystem":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."]}}

# Agent orchestration and container-local session memory.
manager.max_orchestration_rounds=10
manager.memory_path=/app/MEMORY.md
manager.memory_max_prompt_chars=32000

# Tool backends.
tools.kubectl.path=kubectl
tools.kubectl.timeout_seconds=30
tools.prometheus.base_url=http://localhost:9090
tools.prometheus.timeout_seconds=10
tools.loki.base_url=http://localhost:3100
tools.loki.timeout_seconds=10
tools.jaeger.base_url=http://localhost:16686
tools.jaeger.timeout_seconds=10
tools.network.namespace=utility
tools.network.overlay_selector=app.kubernetes.io/name=cloudagent-network-probe,app.kubernetes.io/component=overlay
tools.network.underlay_selector=app.kubernetes.io/name=cloudagent-network-probe,app.kubernetes.io/component=underlay
tools.network.timeout_seconds=30
tools.network.max_duration_seconds=10
tools.network.max_bitrate_mbps=100
tools.network.max_matrix_nodes=6

# Legacy model client. This retired service is retained for migration tests only.
client.type=openai
client.params.model=replace-with-model-name
client.params.url=http://localhost:8000/v1
client.params.token=EMPTY
client.params.timeout_seconds=60

# Postgres anomaly workflow.
postgres.dsn=postgresql://postgres:postgres@localhost:5432/postgres
postgres.poll_interval_seconds=10

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
