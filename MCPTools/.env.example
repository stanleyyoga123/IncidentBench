server.host=0.0.0.0
server.port=8090
server.profile=investigation
server.token=<profile-specific-token>
tools.kubectl.path=kubectl
tools.kubectl.timeout_seconds=30
tools.prometheus.base_url=http://localhost:9090
tools.prometheus.timeout_seconds=20
tools.loki.base_url=http://localhost:3100
tools.loki.timeout_seconds=20
tools.jaeger.base_url=http://localhost:16686
tools.jaeger.timeout_seconds=120
tools.network.namespace=utility
tools.remediation_root=/var/lib/mcp-tools/remediation
