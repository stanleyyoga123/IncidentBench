database.dsn=postgresql://agent:agent@localhost:5432/agents
api.host=0.0.0.0
api.port=8080
api.ingestion_token=<ingestion-token>
api.control_token=<control-token>
api.store_token=<agent-store-token>
rca.base_url=http://localhost:8081
rca.token=<rca-submit-token>
remediator.base_url=http://localhost:8082
remediator.token=<remediator-submit-token>
learning.base_url=http://localhost:8083
learning.token=<learning-submit-token>
scheduler.intake_interval_seconds=60
scheduler.reconcile_interval_seconds=5
scheduler.batch_size=100
