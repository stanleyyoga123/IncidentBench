        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (\n  rate({namespace=~\"$namespace\", app=~\"$app\", pod=~\"$pod\", container=~\"$container\"} |~ \"$search\" [$__interval])\n)",
          "legendFormat": "{{pod}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log Volume by Pod",
      "type": "timeseries"
