{
  "schema_version": 1,
  "global_config": "../../../config/bundled.json",
  "name": "teastore-pod-persistence-cpu-all-one-hour",
  "application": "teastore",
  "placement": "canonical-six-node",
  "steps": [
    {
      "name": "01-persistence-cpu-all-chaos",
      "chaos": [
        "teastore-persistence-cpu"
      ],
      "duration": 3600
    },
    {
      "name": "02-recovery",
      "chaos": [],
      "duration": 600
    }
  ],
  "load": {
    "type": "constant",
    "parameters": {
      "users": 200,
      "bias_users": 20
    }
  }
}
