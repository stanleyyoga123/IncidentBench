{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "application": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "placement": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "load": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "constant"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "users": {
                  "type": "integer",
                  "minimum": 1
                },
                "bias_users": {
                  "type": "integer",
                  "minimum": 0
                },
                "spawn_rate": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "burst"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "baseline_users": {
                  "type": "integer",
                  "minimum": 1
                },
                "peak_users": {
                  "type": "integer",
                  "minimum": 1
                },
                "baseline_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "peak_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "spawn_rate": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "bias_users": {
                  "type": "integer",
                  "minimum": 0
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "sinus"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "min_users": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_users": {
                  "type": "integer",
                  "minimum": 1
                },
                "period_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "spawn_rate": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "bias_users": {
                  "type": "integer",
                  "minimum": 0
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "daily"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "base_users": {
                  "type": "integer",
                  "minimum": 1
                },
                "stages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "duration": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "percentage_users": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "spawn_rate": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "duration",
                      "percentage_users",
                      "spawn_rate"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "timing": {
      "type": "object",
      "properties": {
        "baseline_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "grace_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "baseline_seconds",
        "grace_seconds"
      ],
      "additionalProperties": false
    },
    "integration": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "agents_enabled": {
      "type": "boolean"
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "namespace",
          "name",
          "replicas"
        ],
        "additionalProperties": false
      }
    },
    "prerun": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "postrun": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "chaos": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "duration": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "chaos",
          "duration"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "application",
    "placement",
    "load",
    "timing",
    "integration",
    "agents_enabled",
    "deployments",
    "prerun",
    "postrun",
    "steps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
