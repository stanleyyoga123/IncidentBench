        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (\n  rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}[$__rate_interval])\n)\nor on (pod)\n0 * sum by (pod) (\n  kube_pod_info{namespace=~\"$namespace\", pod=~\"$pod\"}\n)",
