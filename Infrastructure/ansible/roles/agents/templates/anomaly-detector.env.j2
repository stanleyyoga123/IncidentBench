collector.metadata.namespaces=["{{ application_namespace }}"]
collector.metadata.excluded_nodes=["tools-node"]
collector.metrics.base_url=http://prometheus-server.{{ prometheus_namespace }}.svc.cluster.local
collector.metrics.timeout=10
collector.metrics.history_minutes=65
collector.metrics.query_step_seconds=30
collector.metrics.max_concurrency=4
detector.interval_seconds=30
detector.cooldown_seconds=120
detector.api_host=0.0.0.0
detector.api_port=8080
detector.profile_api_token={{ detector_profile_api_token }}
orchestrator.base_url=http://agent-orchestrator.{{ agents_namespace }}.svc.cluster.local:8080
orchestrator.ingestion_token={{ agent_ingestion_token }}
orchestrator.timeout_seconds=10
orchestrator.max_attempts=3
