# Only source files required by this component image enter the build context.
*
!Dockerfile
!requirements.txt
!app/
!app/**

# Keep local credentials and generated files out of included source folders.
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/kubeconfig*
**/.vault-password
**/secret.yml
**/secret.yaml
**/.ipynb_checkpoint
**/.ipynb_checkpoints
