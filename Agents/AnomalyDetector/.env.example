# Metadata collector
collector.metadata.namespaces=["online-boutique","teastore","sock-shop"]
collector.metadata.excluded_nodes=["tools-node","misc-node-1"]

# Prometheus metrics collector
collector.metrics.base_url=http://localhost:9090
collector.metrics.timeout=10
collector.metrics.history_minutes=65
collector.metrics.query_step_seconds=30
collector.metrics.max_concurrency=4

# Committed anomaly ingestion
orchestrator.base_url=http://agent-orchestrator:8080
orchestrator.ingestion_token=replace-with-a-long-random-ingestion-token
orchestrator.timeout_seconds=10
orchestrator.max_attempts=3

# Detector loop
detector.interval_seconds=30
detector.cooldown_seconds=120
detector.api_host=0.0.0.0
detector.api_port=8080
# Mutating profile endpoints return 503 until this token is configured.
detector.profile_api_token=replace-with-a-long-random-token
